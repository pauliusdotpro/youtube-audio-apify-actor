          "durationSeconds": { "label": "Duration (s)", "format": "number" },
          "link": { "label": "Download link", "format": "link" },
          "linkExpiresAt": { "label": "Link expires", "format": "date" },
          "keyValueStoreUrl": { "label": "Stored file", "format": "link" },
          "error": { "label": "Error", "format": "text" }
        }
      }
    },
    "failures": {
